# Copia este archivo como .env si quieres cambiar algo. Todos los valores son opcionales.
# La API lo carga sola al encender.

PORT=3000

# Frontends que pueden llamar a la API (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

# Rate limit
# ventana del límite general y de escritura (1 minuto)
RATE_WINDOW_MS=60000
# peticiones por ventana a toda la API
RATE_LIMIT_GENERAL=100
# crear / editar / eliminar / prestar / vender por ventana
RATE_LIMIT_WRITE=25
# ventana de login y registro (15 minutos)
RATE_AUTH_WINDOW_MS=900000
# intentos FALLIDOS de acceso por ventana
RATE_LIMIT_AUTH=8
# pon 1 si despliegas detrás de un proxy (Render, Railway, nginx)
TRUST_PROXY=

# Reglas de la biblioteca
# duración de la sesión
SESSION_MINUTES=120
# días por defecto para devolver un préstamo
LOAN_DAYS=14
# préstamos activos por usuario
MAX_LOANS=3
